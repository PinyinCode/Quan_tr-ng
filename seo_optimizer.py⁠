# -*- coding: utf-8 -*-
"""
Script Python tự động tối ưu SEO, Thẻ mô tả, Favicon và chống lỗi snippet Google (Phiên bản An toàn & Linh hoạt)
"""

import os
import re

SEO_CONFIG = {
    "title": "Học tiếng Trung · Văn phòng & Công xưởng",
    "description": "Học tiếng Trung giao tiếp Văn phòng & Công xưởng miễn phí. Tổng hợp từ vựng, mẫu câu thông dụng, luyện viết chữ Hán và phát âm chuẩn.",
    "keywords": "tiếng trung văn phòng, tiếng trung công xưởng, học tiếng trung miễn phí, từ vựng tiếng trung",
    "author": "Tuhoctiengtrung.org",
    "canonical_url": "https://tuhoctiengtrung.org/",
    "favicon": "favicon.png" 
}

def optimize_html_file(file_path):
    if not os.path.exists(file_path):
        print(f"❌ Không tìm thấy file: {file_path}")
        return

    with open(file_path, 'r', encoding='utf-8') as f:
        content = f.read()

    print(f"🔄 Đang xử lý file: {file_path}...")

    # 1. Tối ưu hoặc thêm thẻ Title (Bất kể viết hoa hay thường)
    title_tag = f"<title>{SEO_CONFIG['title']}</title>"
    if re.search(r'<title\b[^>]*>.*?</title>', content, re.IGNORECASE):
        content = re.sub(r'<title\b[^>]*>.*?</title>', title_tag, content, flags=re.IGNORECASE)
    else:
        # Nếu chưa có title, tìm thẻ <head> (không phân biệt hoa thường) để chèn vào sau
        content = re.sub(r'(<head\b[^>]*>)', r'\1\n    ' + title_tag, content, flags=re.IGNORECASE)

    # 2. Tối ưu hoặc thêm thẻ Meta Description chuẩn SEO
    desc_tag = f'<meta name="description" content="{SEO_CONFIG["description"]}">'
    if re.search(r'<meta\s+name=["\']description["\'][^>]*>', content, re.IGNORECASE):
        content = re.sub(r'<meta\s+name=["\']description["\'][^>]*>', desc_tag, content, flags=re.IGNORECASE)
    else:
        # Chèn ngay sau thẻ title hoặc head
        content = re.sub(r'(</title>)', r'\1\n    ' + desc_tag, content, flags=re.IGNORECASE)

    # 3. Thêm hoặc cập nhật Favicon
    favicon_tag = f'<link rel="icon" type="image/png" href="/{SEO_CONFIG["favicon"]}">'
    if re.search(r'<link[^>]*rel=["\'](shortcut )?icon["\'][^>]*>', content, re.IGNORECASE):
        content = re.sub(r'<link[^>]*rel=["\'](shortcut )?icon["\'][^>]*>', favicon_tag, content, flags=re.IGNORECASE)
    else:
        content = re.sub(r'(</title>)', r'\1\n    ' + favicon_tag, content, flags=re.IGNORECASE)

    # 4. Thêm các thẻ Meta phụ trợ và Open Graph nếu chưa có
    extra_metas = f"""
    <meta name="keywords" content="{SEO_CONFIG['keywords']}">
    <meta name="author" content="{SEO_CONFIG['author']}">
    <link rel="canonical" href="{SEO_CONFIG['canonical_url']}">
    <meta property="og:title" content="{SEO_CONFIG['title']}">
    <meta property="og:description" content="{SEO_CONFIG['description']}">
    <meta property="og:url" content="{SEO_CONFIG['canonical_url']}">
    <meta property="og:type" content="website">
    """
    if 'rel="canonical"' not in content:
        content = re.sub(r'(</head>)', extra_metas + r'\1', content, flags=re.IGNORECASE)

    # 5. Tự động thêm `data-nosnippet` vào banner marquee an toàn hơn
    # Dùng regex linh hoạt để bắt thẻ div có chứa class quick-intro-banner
    banner_pattern = r'(<div\b[^>]*class\s*=\s*["\'][^"\']*quick-intro-banner[^"\']*["\'][^>]*)'
    if re.search(banner_pattern, content, re.IGNORECASE):
        # Kiểm tra xem đã có data-nosnippet chưa, nếu chưa thì thêm vào
        def add_nosnippet(match):
            tag = match.group(1)
            if 'data-nosnippet' not in tag:
                return tag + ' data-nosnippet'
            return tag
        content = re.sub(banner_pattern, add_nosnippet, content, flags=re.IGNORECASE)
        print("🛡️ Đã thêm thuộc tính data-nosnippet cho banner thành công.")
    else:
        print("⚠️ Lưu ý: Không tìm thấy thẻ div mang class 'quick-intro-banner' trong file HTML.")

    # Ghi lại file index.html
    with open(file_path, 'w', encoding='utf-8') as f:
        f.write(content)

    print(f"✅ Đã tối ưu xong toàn bộ file {file_path}!")

if __name__ == "__main__":
    optimize_html_file("index.html")
